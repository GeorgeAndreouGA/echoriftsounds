NODE_ENV=production

# API auth
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_IPS=172.45.29.1,172.44.29.0/24
COOKIE_SECRET=

# How long an admin login lasts, in hours — the ceiling on an ACTIVE session.
# Defaults to 2 if unset/invalid.
SESSION_HOURS=2

# Minutes of inactivity (no mouse/key/click) before the admin panel logs itself
# out. Independent of SESSION_HOURS: this fires first when you walk away, that
# one caps a session you're actively using. Defaults to 15 if unset/invalid.
IDLE_MINUTES=15

# Swagger UI (set to true in dev to enable /api/docs)
SWAGGER_ENABLED=false

# API server
WEB_ORIGIN=http://localhost:3000


# Subpath the whole app is served under (leading slash, no trailing slash),
# e.g. /music. Leave empty to serve at the domain root. Consumed by the web
# build (Next basePath), the API (route/static/cookie prefixes) and Caddy.
# Changing it requires rebuilding the web image.
BASE_PATH=

# Web
API_INTERNAL_URL=http://api:3001
SITE_NAME=EchoRiftSounds
YOUTUBE_URL=
INSTAGRAM_URL=
FACEBOOK_URL=