
{
	# We're behind no automatic TLS — TLS termination, if any,
	# happens at an upstream proxy (Cloudflare Tunnel / tailscale serve).
	auto_https off
	admin off

	# Trust X-Forwarded-* headers when the immediate hop is from a private
	# range (loopback, docker bridge, RFC1918). Without this Caddy strips
	# the chain even from a trusted local proxy like `tailscale serve`,
	# so the API only ever sees the docker bridge IP — not the tailnet
	# client. private_ranges is Caddy's named matcher; safe because
	# external attackers can never originate from these ranges.
	servers {
		trusted_proxies static private_ranges
	}
}

# Liveness endpoint — answered by Caddy itself, no upstream involved.
# Mounted on both listeners so docker healthcheck can probe either.
(healthz) {
	handle /healthz {
		respond "OK" 200 {
			close
		}
	}
}

# Shared upstream routing. {$BASE_PATH} is the subpath the whole app is served
# under (e.g. /music), injected from the BASE_PATH env var. Empty = domain root.
(routes) {
	# Compress text responses. The one that matters is the waveform peaks JSON:
	# a 2-hour track is ~123 KB uncompressed and ~29 KB gzipped (23.6%), paid by
	# every first-time listener on every long track. Audio is excluded by path —
	# it is already compressed, so gzipping it would burn CPU for nothing, and
	# the /audio and /stream handlers below deliberately stream unbuffered.
	# (Caddy's default encode matcher would also skip audio/* content types;
	# the path matcher makes that independent of Caddy's defaults.)
	# `encode` sets Vary: Accept-Encoding itself, so shared caches stay correct.
	@compressible not path {$BASE_PATH}/audio/* {$BASE_PATH}/stream/*
	encode @compressible zstd gzip

	# REST API and static music streaming go straight to the NestJS service.
	handle {$BASE_PATH}/api/* {
		reverse_proxy api:3001
	}
	# Long-form audio streaming. flush_interval -1 disables Caddy buffering so
	# bytes leave the proxy as soon as Express writes them; zero read/write
	# timeouts let a single socket carry a multi-hour download or stay idle
	# between Range chunks. Stripping Accept-Encoding prevents any future
	# upstream middleware from gzipping (incompressible) audio.
	handle {$BASE_PATH}/audio/* {
		reverse_proxy api:3001 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 10s
				response_header_timeout 30s
				keepalive 2m
				keepalive_idle_conns 64
			}
			header_up -Accept-Encoding
		}
	}
	# Compressed playback streams (AAC/M4A proxies). Same streaming tuning as
	# /audio: unbuffered passthrough so Range chunks leave immediately, no gzip.
	handle {$BASE_PATH}/stream/* {
		reverse_proxy api:3001 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 10s
				response_header_timeout 30s
				keepalive 2m
				keepalive_idle_conns 64
			}
			header_up -Accept-Encoding
		}
	}
	# Everything else — the bare subpath, Next.js pages, and /_next assets
	# (which Next emits under {$BASE_PATH}) — is the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}

# Structured JSON logging for both listeners.
# Healthz hits are noisy, so we filter them out at log time.
(logging) {
	log {
		output stdout
		format json
		level INFO
	}
	log_skip /healthz
}

# ── Single public listener ────────────────────────────────────────
# Serves the public site, the audio API, AND the admin panel on one
# port. There is no separate admin listener anymore — admin routes
# (/api/admin/*) are gated at the app layer by the API's
# IpWhitelistGuard, which reads the real client IP from X-Forwarded-For
# (appended by Caddy) and checks it against ADMIN_IPS in .env.
:8080 {
	import logging
	import healthz

	# Swagger UI exposes the full API schema. Keep it blocked at the edge
	# so an accidental SWAGGER_ENABLED=true in prod can't leak the schema
	# publicly. (Swagger isn't covered by the admin IP guard.)
	@swaggerDocs path {$BASE_PATH}/api/docs {$BASE_PATH}/api/docs/* {$BASE_PATH}/api/docs-json {$BASE_PATH}/api/docs-yaml
	handle @swaggerDocs {
		respond "Not Found" 404
	}

	import routes
}
